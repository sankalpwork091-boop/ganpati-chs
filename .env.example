# ---------------------------------------------------------------------------
# Ganpati CHS Portal — environment variables
#
# Copy to .env.local for local development, and set the same names in the
# Vercel project settings for deployment. NEVER commit real values.
# ---------------------------------------------------------------------------

# --- AWS (shared by Secrets Manager, S3 and SES) ---------------------------
# Credentials belong to the dedicated `ganpati-chs-app` IAM user, whose policies
# are scoped to this one S3 bucket and this one Secrets Manager secret.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Database --------------------------------------------------------------
# DATABASE_URL is deliberately NOT set. The connection string is built at
# runtime from this secret (username/password/host/port/dbname).
# Format: arn:aws:secretsmanager:ap-south-1:<account-id>:secret:rds!db-xxxxx
DB_SECRET_ARN=

# Optional: only needed if the secret does not carry host/port/dbname itself.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=ganpatichs

# Optional: how long a fetched connection string may be reused, in ms.
# Keeps a rotated password from being used for longer than this. Default 10 min.
# DB_SECRET_CACHE_TTL_MS=600000

# Optional escape hatch for local development against a plain Postgres
# container. Used only when DB_SECRET_ARN is empty. Do not use in production.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ganpatichs

# --- S3 (document storage) -------------------------------------------------
# Private bucket, all public access blocked, versioning + SSE-S3 on.
AWS_S3_BUCKET_NAME=

# --- Auth ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The deployed URL (or http://localhost:3000 locally).
NEXTAUTH_URL=http://localhost:3000

# Session encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Reserved for a future admin session store handled outside NextAuth. Admin
# sessions currently run through NextAuth's credentials provider and are signed
# with NEXTAUTH_SECRET, so this is not read by the app yet.
ADMIN_SESSION_SECRET=

# --- Email (Amazon SES) ----------------------------------------------------
# May differ from AWS_REGION if SES is set up elsewhere.
SES_REGION=ap-south-1
# Must be a verified sender identity in SES.
SES_FROM_ADDRESS=
